# anthropic (default) or openai (any OpenAI-compatible API)
LLM_PROVIDER=anthropic
# Defaults to claude-haiku-5-5 for anthropic; required for openai
# LLM_MODEL=

ANTHROPIC_API_KEY=

# OPENAI_API_KEY=
# Set for non-OpenAI compatible endpoints (vLLM, Ollama, OpenRouter, ...)
# OPENAI_BASE_URL=http://localhost:11434/v1
